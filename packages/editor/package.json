{
  "name": "@canvas-commons/editor",
  "version": "0.3.1",
  "description": "A visual editor for Canvas Commons",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/src/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/main.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "canvas-commons",
  "homepage": "https://canvascommons.io/",
  "bugs": "https://github.com/canvas-commons/canvas-commons/issues",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "type": "tsc -w",
    "showcase": "tsc && vite build -c vite.showcase.ts",
    "preview": "vite preview",
    "lint:pkg": "publint --strict && attw --pack . --profile esm-only --ignore-rules internal-resolution-error --exclude-entrypoints ./style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canvas-commons/canvas-commons.git",
    "directory": "packages/editor"
  },
  "files": [
    "dist",
    "tsconfig.plugin.json"
  ],
  "dependencies": {
    "@canvas-commons/core": "workspace:^",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.1.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.1",
    "@preact/signals": "catalog:",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "highlight.js": "^11.9.0",
    "marked": "^15.0.0",
    "preact": "catalog:"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "catalog:",
    "clsx": "catalog:",
    "sass": "^1.69.5",
    "source-map-js": "^1.0.2",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4"
  }
}
